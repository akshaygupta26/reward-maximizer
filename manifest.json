{
  "manifest_version": 3,
  "name": "Reward Maximizer",
  "version": "2.1.0",
  "description": "Sync and stack credit card offers for maximum rewards. Compare point values across cards and find the best deals.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Reward Maximizer"
  },
  "options_ui": {
    "page": "settings/settings.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.americanexpress.com/*"
      ],
      "js": [
        "lib/debug.js",
        "lib/categories.js",
        "lib/extractor-config.js",
        "lib/interceptor-health.js",
        "lib/offer-utils.js",
        "content/utils.js",
        "content/interceptors/base-interceptor.js",
        "content/interceptors/amex-interceptor.js",
        "content/batch-optin.js",
        "content/scrapers/amex.js",
        "content/content-main.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.chase.com/*"
      ],
      "js": [
        "content/chase-api-interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.chase.com/*"
      ],
      "js": [
        "lib/debug.js",
        "lib/categories.js",
        "lib/extractor-config.js",
        "lib/interceptor-health.js",
        "lib/offer-utils.js",
        "content/utils.js",
        "content/interceptors/base-interceptor.js",
        "content/interceptors/chase-interceptor.js",
        "content/batch-optin.js",
        "content/scrapers/chase.js",
        "content/content-main.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.citi.com/*",
        "https://*.citibank.com/*"
      ],
      "js": [
        "lib/debug.js",
        "lib/categories.js",
        "lib/extractor-config.js",
        "lib/interceptor-health.js",
        "lib/offer-utils.js",
        "content/utils.js",
        "content/interceptors/base-interceptor.js",
        "content/interceptors/citi-interceptor.js",
        "content/scrapers/citi.js",
        "content/content-main.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.capitalone.com/*"
      ],
      "js": [
        "lib/debug.js",
        "lib/categories.js",
        "lib/extractor-config.js",
        "lib/interceptor-health.js",
        "lib/offer-utils.js",
        "content/utils.js",
        "content/interceptors/base-interceptor.js",
        "content/interceptors/capital-one-interceptor.js",
        "content/scrapers/capital-one.js",
        "content/content-main.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.capitaloneshopping.com/*"
      ],
      "js": [
        "lib/debug.js",
        "lib/categories.js",
        "lib/offer-utils.js",
        "content/utils.js",
        "content/scrapers/capital-one-shopping.js",
        "content/content-main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.discover.com/*"
      ],
      "js": [
        "lib/debug.js",
        "lib/categories.js",
        "lib/extractor-config.js",
        "lib/interceptor-health.js",
        "lib/offer-utils.js",
        "content/utils.js",
        "content/interceptors/base-interceptor.js",
        "content/interceptors/discover-interceptor.js",
        "content/scrapers/discover.js",
        "content/content-main.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.bankofamerica.com/*",
        "https://*.bofa.com/*"
      ],
      "js": [
        "lib/debug.js",
        "lib/categories.js",
        "lib/extractor-config.js",
        "lib/interceptor-health.js",
        "lib/offer-utils.js",
        "content/utils.js",
        "content/interceptors/base-interceptor.js",
        "content/interceptors/bofa-interceptor.js",
        "content/scrapers/bofa.js",
        "content/content-main.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.usbank.com/*"
      ],
      "js": [
        "lib/debug.js",
        "lib/categories.js",
        "lib/extractor-config.js",
        "lib/interceptor-health.js",
        "lib/offer-utils.js",
        "content/utils.js",
        "content/interceptors/base-interceptor.js",
        "content/interceptors/usbank-interceptor.js",
        "content/scrapers/usbank.js",
        "content/content-main.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.rakuten.com/*"
      ],
      "js": [
        "lib/debug.js",
        "lib/categories.js",
        "lib/offer-utils.js",
        "content/utils.js",
        "content/scrapers/rakuten.js",
        "content/content-main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/debug.js",
        "lib/offer-utils.js",
        "data/referral.js",
        "content/merchant-banner.js"
      ],
      "run_at": "document_idle",
      "exclude_matches": [
        "https://*.americanexpress.com/*",
        "https://*.chase.com/*",
        "https://*.citi.com/*",
        "https://*.citibank.com/*",
        "https://*.capitalone.com/*",
        "https://*.capitaloneshopping.com/*",
        "https://*.discover.com/*",
        "https://*.bankofamerica.com/*",
        "https://*.bofa.com/*",
        "https://*.usbank.com/*",
        "https://*.rakuten.com/*"
      ]
    }
  ]
}
